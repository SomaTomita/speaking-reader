{
  "name": "ielts-speaking-reader",
  "version": "0.1.0",
  "private": true,
  "description": "Static IELTS speaking lesson reader with Web Speech TTS. Parses Markdown lessons into a browser-loadable dataset.",
  "type": "module",
  "scripts": {
    "build:data": "tsx src/build/build-data.ts",
    "build:app": "esbuild src/app/reader-app.ts --bundle --outfile=public/app.js --target=es2020 --format=iife --minify",
    "build:audio": "tsx src/build/generate-audio.ts",
    "build": "npm run build:data && npm run build:app",
    "dev": "npm run build && npx http-server public -p 8080 -c-1 -o",
    "deploy": "npm run build && wrangler pages deploy",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.0",
    "wrangler": "^4.99.0"
  },
  "dependencies": {
    "node-edge-tts": "^1.2.10"
  }
}
